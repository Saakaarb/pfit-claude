# Local scratch / throwaway work (not tracked)
scratch/

# Paper / documentation working files (not tracked)
docs/

# Python caches
__pycache__/
*.pyc

# personal git auth (never commit)
git-auth.config
*.credentials
.pfit-personal-pat
*personal-pat*

