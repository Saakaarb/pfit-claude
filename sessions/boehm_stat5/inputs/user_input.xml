<?xml version="1.0" ?>
<FIT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = data.csv </E>
        </FILENAME>
    </EXPERIMENT>

    <MODEL>
        <TRAINABLE_PARAMETERS>
            <P> N_TRAINABLE_PARAMETERS = 6 </P>
        </TRAINABLE_PARAMETERS>
        <TRAINABLE_PARAMETER_DESCRIPTION>
            <PARAM>
                <P> PARAMETER_NAME = k_deg </P>
                <P> MIN_VAL = 2.7E-4 </P>
                <P> MAX_VAL = 2.7E0 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_exp_hetero </P>
                <P> MIN_VAL = 1E-7 </P>
                <P> MAX_VAL = 1E-3 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_exp_homo </P>
                <P> MIN_VAL = 6.17E-5 </P>
                <P> MAX_VAL = 6.17E-1 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_imp_hetero </P>
                <P> MIN_VAL = 1.64E-4 </P>
                <P> MAX_VAL = 1.64E0 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_imp_homo </P>
                <P> MIN_VAL = 9.77E2 </P>
                <P> MAX_VAL = 9.77E6 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_phos </P>
                <P> MIN_VAL = 1.58E2 </P>
                <P> MAX_VAL = 1.58E6 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
        </TRAINABLE_PARAMETER_DESCRIPTION>

        <FIXED_PARAM_DESCRIPTION>
            <PARAM>
                <P> NAME = specC17 </P>
                <P> VALUE = 0.107 </P>
            </PARAM>
            <PARAM>
                <P> NAME = Epo0 </P>
                <P> VALUE = 1.25E-7 </P>
            </PARAM>
            <PARAM>
                <P> NAME = cyt </P>
                <P> VALUE = 1.4 </P>
            </PARAM>
            <PARAM>
                <P> NAME = nuc </P>
                <P> VALUE = 0.45 </P>
            </PARAM>
        </FIXED_PARAM_DESCRIPTION>

        <INTEGRATED_SYSTEM_DESCRIPTION>
            <VAR>
                <P> NAME = A </P>
                <P> INIT_VAL = 143.8668 </P>
            </VAR>
            <VAR>
                <P> NAME = B </P>
                <P> INIT_VAL = 63.7332 </P>
            </VAR>
            <VAR>
                <P> NAME = ApB </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = ApA </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = BpB </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = nApA </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = nApB </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = nBpB </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
        </INTEGRATED_SYSTEM_DESCRIPTION>
    </MODEL>

    <POPULATION_OPT>
        <SETTINGS>
            <P> POPULATION_SIZE = 600 </P>
            <P> NUM_ITERS = 30 </P>
            <P> PROCESSORS = 16 </P>
            <P> ALGORITHM = DE </P>
            <P> RANDOM_SEED = 0 </P>
            <P> POP_STEPSIZE_RTOL = 1E-5,1E-5,1E-5,1E-5,1E-5,1E-5,1E-5,1E-5 </P>
            <P> POP_STEPSIZE_ATOL = 1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7 </P>
        </SETTINGS>
    </POPULATION_OPT>

    <GRADIENT_OPT>
        <SETTINGS>
            <P> NUM_ITERS = 1000 </P>
            <P> STEPSIZE_RTOL = 1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7 </P>
            <P> STEPSIZE_ATOL = 1E-9,1E-9,1E-9,1E-9,1E-9,1E-9,1E-9,1E-9 </P>
            <P> INITIAL_TIMESTEP = 1E-6 </P>
            <P> INITIAL_TIME = 0.0 </P>
            <P> MAX_STEPS = 10000 </P>
            <P> INTEGRATOR = Kvaerno5 </P>
            <P> GRADIENT_OPTIMIZER = adam </P>
            <P> INIT_VALUE_LR = 1e-3 </P>
            <P> END_VALUE_LR = 1e-5 </P>
            <P> TRANSITION_STEPS_LR = 200 </P>
            <P> DECAY_RATE_LR = 0.9 </P>
        </SETTINGS>
    </GRADIENT_OPT>

    <PLOTTING_INFO>
        <P> WRITE_RESULTS = Y </P>
    </PLOTTING_INFO>
</FIT>
