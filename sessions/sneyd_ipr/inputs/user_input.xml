<?xml version="1.0" ?>
<FIT>
    <!-- Nine clamp conditions. IP3 and Ca are carried as zero-derivative input
         states; each experiment overrides their initial values. -->
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca01.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.1 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca02.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.2 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca04.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.4 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca1.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 1.0 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca3.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 3.0 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ca10.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ip3.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 3.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.4 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ip5.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 5.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.4 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>
    <EXPERIMENT>
        <FILENAME>
            <E> FILENAME_DATA = ip10.csv </E>
        </FILENAME>
        <INITIAL_CONDITIONS>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.4 </P>
            </VAR>
        </INITIAL_CONDITIONS>
    </EXPERIMENT>

    <MODEL>
        <TRAINABLE_PARAMETERS>
            <P> N_TRAINABLE_PARAMETERS = 14 </P>
        </TRAINABLE_PARAMETERS>
        <TRAINABLE_PARAMETER_DESCRIPTION>
            <PARAM>
                <P> PARAMETER_NAME = k1 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k2 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k3 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k4 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_1 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_2 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_3 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = k_4 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l2 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l4 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l6 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l_2 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l_4 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
            <PARAM>
                <P> PARAMETER_NAME = l_6 </P>
                <P> MIN_VAL = 1E-3 </P>
                <P> MAX_VAL = 1E5 </P>
                <P> LOGSCALE = Y </P>
            </PARAM>
        </TRAINABLE_PARAMETER_DESCRIPTION>

        <INTEGRATED_SYSTEM_DESCRIPTION>
            <VAR>
                <P> NAME = O </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = R </P>
                <P> INIT_VAL = 1.0 </P>
            </VAR>
            <VAR>
                <P> NAME = I1 </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = S </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = A </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = I2 </P>
                <P> INIT_VAL = 0.0 </P>
            </VAR>
            <VAR>
                <P> NAME = IP3 </P>
                <P> INIT_VAL = 10.0 </P>
            </VAR>
            <VAR>
                <P> NAME = Ca </P>
                <P> INIT_VAL = 0.4 </P>
            </VAR>
        </INTEGRATED_SYSTEM_DESCRIPTION>
    </MODEL>

    <POPULATION_OPT>
        <SETTINGS>
            <P> POPULATION_SIZE = 1000 </P>
            <P> NUM_ITERS = 30 </P>
            <P> PROCESSORS = 16 </P>
            <P> ALGORITHM = DE </P>
            <P> RANDOM_SEED = 0 </P>
            <P> POP_STEPSIZE_RTOL = 1E-5,1E-5,1E-5,1E-5,1E-5,1E-5,1E-5,1E-5 </P>
            <P> POP_STEPSIZE_ATOL = 1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7 </P>
        </SETTINGS>
    </POPULATION_OPT>

    <GRADIENT_OPT>
        <SETTINGS>
            <P> NUM_ITERS = 1000 </P>
            <P> STEPSIZE_RTOL = 1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7,1E-7 </P>
            <P> STEPSIZE_ATOL = 1E-9,1E-9,1E-9,1E-9,1E-9,1E-9,1E-9,1E-9 </P>
            <P> INITIAL_TIMESTEP = 1E-6 </P>
            <P> INITIAL_TIME = 0.0 </P>
            <P> MAX_STEPS = 10000 </P>
            <P> INTEGRATOR = Kvaerno5 </P>
            <P> GRADIENT_OPTIMIZER = adam </P>
            <P> INIT_VALUE_LR = 1e-3 </P>
            <P> END_VALUE_LR = 1e-5 </P>
            <P> TRANSITION_STEPS_LR = 200 </P>
            <P> DECAY_RATE_LR = 0.9 </P>
        </SETTINGS>
    </GRADIENT_OPT>

    <PLOTTING_INFO>
        <P> WRITE_RESULTS = Y </P>
    </PLOTTING_INFO>
</FIT>
